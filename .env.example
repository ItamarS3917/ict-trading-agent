# ICT Trading Agent Environment Variables
# Copy this file to .env and fill in your values

# Yahoo Finance API (optional - yfinance works without key)
# YAHOO_API_KEY=your_key_here

# OpenAI API Key (optional - for AI-powered analysis)
# OPENAI_API_KEY=sk-your-key-here

# Google Gemini API Key (optional - for AI-powered analysis)
# GEMINI_API_KEY=your-gemini-key-here

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Trading Configuration
DEFAULT_SYMBOL=NQ=F
DEFAULT_TIMEFRAME=1h
RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.05
